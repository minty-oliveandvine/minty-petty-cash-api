# minty-petty-cash-api - copy to .env for a local run (never commit .env).
APP_ENV=development
# The SAME key Flask (Minty) mints the hand-off tokens with; without it every request is 401.
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=*
# The schema Minty owns; ?schema= picks it (default pettycashv3).
DB_SCHEMA=pettycashv3
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres?schema=${DB_SCHEMA}
# Receipts: Backblaze B2 through the S3 API - https://KEY:SECRET@s3.<region>.backblazeb2.com/<bucket>
S3_URL=
# The browser app allowed through CORS.
PETTY_CASH_WEB_URL=http://localhost:3010
# Flask (Minty): the Xero token service for a new supplier. Required outside development
# (APP_ENV=development falls back to http://localhost:8000); the service refuses to start without it.
ACCOUNTS_API_URL=http://localhost:8000
# Optional
# CORS_ALLOWED_ORIGINS=http://localhost:3010
# PREVIEW_ORIGIN_REGEX=^https://pr-[a-z0-9-]+-petty-cash\.dailyminty\.com$
# LOG_LEVEL=INFO
# DB_WAIT_SECONDS=180
